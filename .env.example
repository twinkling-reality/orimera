# Copy to .env and fill in. .env is gitignored and must never be committed.

# Nebius Token Factory. Get from https://tokenfactory.nebius.com/ -> Get API key
NEBIUS_API_KEY=

# PostgreSQL bootstrap and non-owner runtime roles. Percent-encode reserved URI characters in
# passwords because compose places them in connection URLs.
POSTGRES_PASSWORD=
ORIMERA_APP_ROLE_PASSWORD=
ORIMERA_EXECUTOR_ROLE_PASSWORD=

# Comma-separated UUIDs the dedicated derivative worker is authorised to drain.
ORIMERA_WORKSPACE_IDS=

# JSON bearer-token directory used by the API. See README.md; never commit a filled value.
ORIMERA_API_TOKENS=

# Tavily. Get from https://tavily.com or the Nebius Builders Program
TAVILY_API_KEY=
