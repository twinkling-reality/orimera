# Copy to .env and fill in. .env is gitignored and must never be committed.

# Nebius Token Factory. Get from https://tokenfactory.nebius.com/ -> Get API key
NEBIUS_API_KEY=

# PostgreSQL bootstrap and non-owner runtime roles. Percent-encode reserved URI characters in
# passwords because compose places them in connection URLs.
POSTGRES_PASSWORD=
ORIMERA_APP_ROLE_PASSWORD=
ORIMERA_EXECUTOR_ROLE_PASSWORD=

# Comma-separated UUIDs the dedicated derivative worker is authorised to drain.
ORIMERA_WORKSPACE_IDS=

# Production depth producer. Compose enables MoGe; override only to pin another reviewed
# checkpoint or select a device such as cuda, cpu, or mps.
ORIMERA_DEPTH_MODEL_ID=Ruicheng/moge-2-vitl
ORIMERA_DEPTH_MODEL_REVISION=39c4d5e957afe587e04eec59dc2bcc3be5ecd968
ORIMERA_DEPTH_DEVICE=

# Exact provenance required by the separate reconstruction-scene worker. The image must be pinned
# by sha256 digest; a mutable tag is refused.
ORIMERA_CODE_REVISION=
ORIMERA_POSE_RUNTIME_IMAGE=

# JSON bearer-token directory used by the API. See README.md; never commit a filled value.
ORIMERA_API_TOKENS=

# Tavily. Get from https://tavily.com or the Nebius Builders Program
TAVILY_API_KEY=
