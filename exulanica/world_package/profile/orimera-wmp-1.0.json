{
  "@context": {
    "cr": "http://mlcommons.org/croissant/",
    "dct": "http://purl.org/dc/terms/",
    "orimera": "https://orimera.local/ns/world-memory-package/1/",
    "rai": "http://mlcommons.org/croissant/RAI/",
    "schema": "https://schema.org/"
  },
  "@id": "https://orimera.local/profiles/world-memory-package/1.0",
  "@type": "schema:CreativeWork",
  "canonicalization": {
    "base": "RFC 8785",
    "floats": "prohibited; source binary floating-point values use exact tagged hexadecimal strings",
    "profile": "orimera-canonical-json/no-float-v1"
  },
  "compatibilityReferences": [
    "http://mlcommons.org/croissant/1.0",
    "http://mlcommons.org/croissant/RAI/1.0",
    "https://www.rfc-editor.org/rfc/rfc8785",
    "https://www.rfc-editor.org/rfc/rfc8032"
  ],
  "conformsTo": [
    "https://www.researchobject.org/ro-crate/1.2/"
  ],
  "defaultPayloadPolicy": {
    "excluded": [
      "raw media",
      "credentials",
      "biometric templates",
      "embeddings",
      "private conversations",
      "model internals",
      "training intermediates",
      "executable UI code",
      "remote executable bindings"
    ],
    "externalMediaReference": "content digest and authorization-dependent resolver requirement only"
  },
  "merkle": {
    "leaf": "sha256('orimera-wmp-leaf-v1\\0' || utf8(path) || '\\0' || sha256(file))",
    "node": "sha256('orimera-wmp-node-v1\\0' || left || right)",
    "oddNode": "duplicate final child",
    "pathOrder": "Unicode code point order"
  },
  "name": "Orimera World Memory Package Profile",
  "signature": {
    "algorithm": "Ed25519",
    "payload": [
      "profile_version",
      "manifest_sha256",
      "merkle_root_sha256"
    ]
  },
  "version": "orimera-wmp-1.0"
}
